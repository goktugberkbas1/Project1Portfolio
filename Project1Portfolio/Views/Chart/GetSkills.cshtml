@using Newtonsoft.Json;
@model List<Project1Portfolio.Models.Skill>

@{
    ViewBag.Title = "GetSkills";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div>
    <canvas id="skillsChart" width="400" height="200"></canvas>
</div>

<!-- Chart.js CDN (Eğer local çalışmıyorsa) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    console.log("Chart.js yükleniyor mu?", typeof Chart !== "undefined");

    var ctx = document.getElementById('skillsChart').getContext('2d');

    var skillsChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: JSON.parse('@Html.Raw(JsonConvert.SerializeObject(Model.Select(s => s.Title).ToList()))'),
            datasets: [{
                label: 'Yetenek Seviyeleri',
                data: JSON.parse('@Html.Raw(JsonConvert.SerializeObject(Model.Select(s => s.Value).ToList()))'),
                backgroundColor: 'rgba(48, 43, 45, 0.8)',
                borderColor: 'rgba(48, 43, 45, 1)',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>


